# Copy this file to backend/.env and replace all development values before deployment.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
# Production MySQL example:
# DATABASE_URL=mysql+mysqlconnector://smartattend:strong-password@localhost:3306/smartattend
# Local development default is SQLite when DATABASE_URL is omitted.
CORS_ORIGINS=http://localhost:5173
BIOMETRIC_ENCRYPTION_KEY=
UPLOAD_FOLDER=uploads
FACE_RECOGNITION_ENABLED=false
